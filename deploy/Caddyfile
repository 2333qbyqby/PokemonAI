{
	email {$ACME_EMAIL}
}

{$PUBLIC_HOST} {
	encode zstd gzip
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; worker-src 'self'; connect-src 'self' https://play.pokemonshowdown.com wss://sim3.psim.us; img-src 'self' data: https://play.pokemonshowdown.com https://*.psim.us https://pokemonshowdown.com; media-src 'self' https://play.pokemonshowdown.com; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self' https://play.pokemonshowdown.com"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	handle /showdown/* {
		reverse_proxy showdown:8000
	}

	handle {
		root * /srv
		@pokemonai_root path /
		rewrite @pokemonai_root /testclient-new.html
		try_files {path} /testclient-new.html
		file_server
	}
}

http://127.0.0.1 {
	respond /healthz "ok" 200
}
